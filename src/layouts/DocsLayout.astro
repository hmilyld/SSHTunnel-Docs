---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { site } from '../data/site';
import { ui, fmt, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  altHref: string;
  title: string;
  description: string;
  groupLabel: string;
  index: string;
  currentSlug: string;
  headings: MarkdownHeading[];
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
}

const { lang, altHref, title, description, groupLabel, index, currentSlug, headings, prev, next } =
  Astro.props;
const t = ui[lang];
const siteName = lang === 'zh' ? site.name : site.nameEn;
---

<BaseLayout
  lang={lang}
  altHref={altHref}
  title={`${title} · ${siteName}`}
  description={description}
>
  <div class="mx-auto max-w-[86rem] px-5 sm:px-8">
    <div class="lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-12 xl:grid-cols-[15rem_minmax(0,1fr)_12.5rem] xl:gap-14">
      <aside class="hidden lg:block">
        <div class="sticky top-14 max-h-[calc(100vh-3.5rem)] overflow-y-auto py-12 pr-2">
          <DocsSidebar lang={lang} currentSlug={currentSlug} />
        </div>
      </aside>

      <main id="main" class="min-w-0 py-8 lg:py-12">
        <details class="mb-8 border border-line bg-panel lg:hidden">
          <summary
            class="flex cursor-pointer list-none items-center justify-between px-4 py-2.5 [&::-webkit-details-marker]:hidden"
          >
            <span class="eyebrow">{t.sidebarLabel}</span>
            <span class="font-mono text-[0.625rem] tracking-widest text-muted">
              <span class="label-closed">{t.navOpen}</span>
              <span class="label-open">{t.navClose}</span>
            </span>
          </summary>
          <div class="border-t border-line px-3 py-4">
            <DocsSidebar lang={lang} currentSlug={currentSlug} />
          </div>
        </details>

        <div class="max-w-[46rem]">
          <header>
            <div class="flex items-center gap-2.5">
              <span class="eyebrow">{groupLabel}</span>
              <span class="h-px w-4 bg-line-strong"></span>
              <span class="eyebrow">{index}</span>
            </div>
            <h1 class="mt-3 text-[1.85rem] font-semibold leading-[1.3] tracking-[-0.03em] sm:text-[2.1rem]">
              {title}
            </h1>
            <p class="mt-3 text-[0.9375rem] leading-[1.8] text-muted">{description}</p>
          </header>

          <hr class="mt-8 border-line" />

          <article class="doc-prose mt-8">
            <slot />
          </article>

          <div class="mt-14 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-4">
            <p class="eyebrow">{fmt(t.versionLine, { version: site.version })}</p>
            <a href={`${site.repo}/issues`} target="_blank" rel="noreferrer" class="eyebrow hover:text-ink">
              {t.feedback}
            </a>
          </div>

          <nav class="mt-6 grid border-t border-line sm:grid-cols-2" aria-label={t.pagination}>
            {
              prev ? (
                <a href={prev.href} class="group flex flex-col gap-1 py-5 sm:pr-6">
                  <span class="eyebrow">{t.prev}</span>
                  <span class="text-sm font-medium text-ink transition-colors group-hover:text-accent">
                    {prev.title}
                  </span>
                </a>
              ) : (
                <span class="hidden sm:block" />
              )
            }
            {
              next && (
                <a
                  href={next.href}
                  class="group flex flex-col gap-1 py-5 sm:border-l sm:border-line sm:pl-6 sm:text-right"
                >
                  <span class="eyebrow">{t.next}</span>
                  <span class="text-sm font-medium text-ink transition-colors group-hover:text-accent">
                    {next.title}
                  </span>
                </a>
              )
            }
          </nav>
        </div>
      </main>

      <aside class="hidden xl:block">
        <div class="sticky top-14 max-h-[calc(100vh-3.5rem)] overflow-y-auto py-12">
          <TableOfContents headings={headings} label={t.tocLabel} />
        </div>
      </aside>
    </div>
  </div>

  <script>
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc] a'));
    if (links.length > 0) {
      const entries = links
        .map((link) => {
          const id = decodeURIComponent(link.hash.slice(1));
          const heading = document.getElementById(id);
          return heading ? { link, heading } : null;
        })
        .filter((entry): entry is { link: HTMLAnchorElement; heading: HTMLElement } => entry !== null);

      const update = () => {
        let current = entries[0];
        for (const entry of entries) {
          if (entry.heading.getBoundingClientRect().top <= 120) current = entry;
        }
        for (const entry of entries) {
          entry.link.classList.toggle('is-active', entry === current);
        }
      };

      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
    }
  </script>
</BaseLayout>

<style>
  .label-open {
    display: none;
  }

  details[open] .label-open {
    display: inline;
  }

  details[open] .label-closed {
    display: none;
  }
</style>
