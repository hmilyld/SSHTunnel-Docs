---
import { render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getDocs, slugOf, docHref, alternateHref, type DocEntry } from '../../lib/docs';
import { groupLabels } from '../../data/nav';

export async function getStaticPaths() {
  const docs = await getDocs('zh');
  return docs.map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props as { entry: DocEntry };
const slug = slugOf(entry.id);

const docs = await getDocs('zh');
const position = docs.findIndex((doc) => doc.id === entry.id);
const previous = position > 0 ? docs[position - 1] : undefined;
const next = position < docs.length - 1 ? docs[position + 1] : undefined;

const siblings = docs.filter((doc) => doc.data.group === entry.data.group);
const indexInGroup = siblings.findIndex((doc) => doc.id === entry.id) + 1;

const { Content, headings } = await render(entry);
---

<DocsLayout
  lang="zh"
  altHref={alternateHref('zh', slug)}
  title={entry.data.title}
  description={entry.data.description}
  groupLabel={groupLabels.zh[entry.data.group]}
  index={String(indexInGroup).padStart(2, '0')}
  currentSlug={slug}
  headings={headings}
  prev={previous && { title: previous.data.title, href: docHref('zh', slugOf(previous.id)) }}
  next={next && { title: next.data.title, href: docHref('zh', slugOf(next.id)) }}
>
  <Content />
</DocsLayout>
