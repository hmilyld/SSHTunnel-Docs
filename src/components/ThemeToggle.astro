---
/** 深/浅主题切换。图标显隐交给 CSS（见 global.css），点击逻辑在 BaseLayout 里 */
interface Props {
  labelDark: string;
  labelLight: string;
  title: string;
}

const { labelDark, labelLight, title } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  data-label-dark={labelDark}
  data-label-light={labelLight}
  aria-label={labelDark}
  aria-pressed="false"
  title={title}
  class="inline-flex h-8 w-8 items-center justify-center border border-line text-muted transition-colors hover:border-line-strong hover:text-ink"
>
  <svg class="icon-moon" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
    <path d="M13.2 9.6A5.6 5.6 0 0 1 6.4 2.8a5.6 5.6 0 1 0 6.8 6.8Z" />
  </svg>
  <svg class="icon-sun" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
    <circle cx="8" cy="8" r="3" />
    <path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13M11.82 11.82l1.13 1.13M12.95 3.05l-1.13 1.13M4.18 11.82l-1.13 1.13" />
  </svg>
</button>
