---
/**
 * 标识：两道竖线（两个端口）+ 中间虚线箭头（转发）。
 * 纯 currentColor，浅/深主题自动跟随。
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 20, class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 20 20"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  aria-hidden="true"
  class={className}
>
  <path d="M3 4.5v11" />
  <path d="M17 4.5v11" />
  <path d="M5.5 10h8.5" stroke-dasharray="2 2.4" />
  <path d="M11.5 7.5 14 10l-2.5 2.5" />
</svg>
